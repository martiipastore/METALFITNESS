# Normaliza finales de línea. Los scripts que corren dentro de contenedores Linux
# deben quedar con LF aunque se editen en Windows.
* text=auto
*.sh text eol=lf
*.js text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.conf text eol=lf
# Migraciones SQL: el mismo contenido en todas las máquinas. La huella de cada
# migración aplicada se compara con LF o CRLF (pkg/migracion), así que las bases
# creadas antes de esta regla siguen arrancando.
*.sql text eol=lf
*.docx binary
*.pdf binary
*.go text eol=lf
